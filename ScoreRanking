public class ScoreRanking {
    
    public static void sortScoresDescending(int[] scores) {
        int n = scores.length;
        boolean swapped;
        int comparisonCount = 0; // ตัวแปรนับจำนวนครั้งของการเปรียบเทียบ
        int swapCount = 0;       // ตัวแปรนับจำนวนครั้งของการสลับข้อมูล
        
        for (int i = 0; i < n - 1; i++) {
            swapped = false;
            for (int j = 0; j < n - 1 - i; j++) {
                comparisonCount++;
                // เปรียบเทียบข้อมูลเพื่อให้ค่ามากขยับไปด้านหน้า (เรียงจากมากไปน้อย)
                if (scores[j] < scores[j + 1]) {
                    int temp = scores[j];
                    scores[j] = scores[j + 1];
                    scores[j + 1] = temp;
                    swapCount++;
                    swapped = true;
                }
            }
            if (!swapped) {
                break; // หยุดการทำงานทันที (Early Exit) หากรอบนี้ไม่มีการสลับข้อมูล
            }
        }
        
        System.out.println("จำนวนครั้งของการเปรียบเทียบ: " + comparisonCount);
        System.out.println("จำนวนครั้งของการสลับข้อมูล: " + swapCount);
    }

    public static void main(String[] args) {
        int[] scores = {72, 91, 65, 88, 79};
        
        System.out.print("คะแนนก่อนเรียง: ");
        for (int score : scores) {
            System.out.print(score + " ");
        }
        System.out.println();
        
        sortScoresDescending(scores);
        
        System.out.print("คะแนนหลังเรียง (จากมากไปน้อย): ");
        for (int score : scores) {
            System.out.print(score + " ");
        }
    }
}
