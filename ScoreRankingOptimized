import java.util.Arrays;

public class ScoreRankingOptimized {

    // เมธอดสำหรับเรียงลำดับคะแนนจากมากไปน้อยด้วย Optimized Bubble Sort
    public static void bubbleSortDescending(int[] scores) {
        int n = scores.length;
        int comparisons = 0; // ตัวนับจำนวนครั้งการเปรียบเทียบ
        int swaps = 0;       // ตัวนับจำนวนครั้งการสลับข้อมูล

        for (int i = 0; i < n - 1; i++) {
            boolean swapped = false;
            for (int j = 0; j < n - 1 - i; j++) {
                comparisons++;
                // เรียงจากมากไปน้อย: ถ้าตัวหน้า < ตัวหลัง ให้ทำการสลับ
                if (scores[j] < scores[j + 1]) {
                    int temp = scores[j];
                    scores[j] = scores[j + 1];
                    scores[j + 1] = temp;
                    
                    swaps++;
                    swapped = true;
                }
            }
            // หากรอบนี้ไม่มีการสลับข้อมูลเลย แสดงว่าเรียงลำดับเรียบร้อยแล้ว
            if (!swapped) {
                break;
            }
        }

        System.out.println("ผลลัพธ์หลังเรียงลำดับ: " + Arrays.toString(scores));
        System.out.println("จำนวนครั้งของการเปรียบเทียบ: " + comparisons);
        System.out.println("จำนวนครั้งของการสลับข้อมูล: " + swaps);
    }

    public static void main(String[] args) {
        // 1. ทดสอบข้อมูลทั่วไปตามโจทย์กำหนด
        int[] scores = {72, 91, 65, 88, 79};
        System.out.println("--- 1. ทดสอบข้อมูลทั่วไปตามโจทย์ ---");
        bubbleSortDescending(scores);

        // 2. วิเคราะห์กรณีข้อมูลเรียงจากมากไปน้อยอยู่แล้ว (Best Case)
        int[] sortedScores = {91, 88, 79, 72, 65};
        System.out.println("\n--- 2. วิเคราะห์กรณีข้อมูลเรียงแล้ว (Best Case) ---");
        bubbleSortDescending(sortedScores);

        // 3. วิเคราะห์กรณีข้อมูลเรียงย้อนกลับจากน้อยไปมาก (Worst Case)
        int[] reverseScores = {65, 72, 79, 88, 91};
        System.out.println("\n--- 3. วิเคราะห์กรณีข้อมูลเรียงย้อนกลับ (Worst Case) ---");
        bubbleSortDescending(reverseScores);
    }
}
